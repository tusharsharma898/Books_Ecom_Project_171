@model Books_Ecom_Project_171_Models.ViewModel.ProductVM

@{
    var title = Model.Product.Id != 0 ? "Edit Product Details :" : "Add New Product :";
    var saveUpdate = Model.Product.Id != 0 ? "Update" : "Save";
}
<div class="text-primary border-bottom">@title</div>

<div class="row">
    <div class="col-6">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @if (Model.Product.Id != 0)
                {
                    <input  type="hidden" asp-for="Product.Id"/>
                }
            <div class="form-group row p-2 m-2">
                <label asp-for="Product.Title"></label><br />
                <input asp-for="Product.Title" class="form-control"/>
                <span asp-validation-for="Product.Title" class="text-danger"></span>
            </div>
            
            <div class="form-group row p-2 m-2">
                <label asp-for="Product.Description"></label><br />
                <input asp-for="Product.Description" class="form-control" />
                <span asp-validation-for="Product.Description" class="text-danger"></span>
            </div>
            <div class="form-group row p-2 m-2">
                <label asp-for="Product.Author"></label><br />
                <input asp-for="Product.Author" class="form-control" />
                <span asp-validation-for="Product.Author" class="text-danger"></span>
            </div>
            <div class="form-group row p-2 m-2">
                <label asp-for="Product.ISBN"></label><br />
                <input asp-for="Product.ISBN" class="form-control" />
                <span asp-validation-for="Product.ISBN" class="text-danger"></span>
            </div>
                <div class="form-group row p-2 m-2">
                <label asp-for="Product.ListPrice"></label><br />
                <input asp-for="Product.ListPrice" class="form-control"/>
                <span asp-validation-for="Product.ListPrice" class="text-danger"></span>
            </div>
            <div class="form-group row p-2 m-2">
                <label asp-for="Product.Price"></label><br />
                <input asp-for="Product.Price" class="form-control" />
                <span asp-validation-for="Product.Price" class="text-danger"></span>
            </div>
            <div class="form-group row p-2 m-2">
                <label asp-for="Product.Price50"></label><br />
                <input asp-for="Product.Price50" class="form-control" />
                <span asp-validation-for="Product.Price50" class="text-danger"></span>
            </div>
            <div class="form-group row p-2 m-2">
                <label asp-for="Product.Price100"></label><br />
                <input asp-for="Product.Price100" class="form-control" />
                <span asp-validation-for="Product.Price100" class="text-danger"></span>
            </div>
            <div class="form-group row p-2 m-2">
                <label asp-for="Product.ImageUrl"></label><br />
                <input type="file" name="files" id="uploadImage" class="form-control" />
                <span asp-validation-for="Product.Price50" class="text-danger"></span>
            </div>
            <div class="form-group row p-2 m-2">
                <label asp-for="Product.CategoryId"></label>
                <select asp-for="Product.CategoryId" asp-items="Model.CategoryList" class="form-control">
    <option value="value">Select Category</option>
</select>
            </div>
            <div class="form-group row p-2 m-2">
                <label asp-for="Product.CoverTypeId"></label>
                <select asp-for="Product.CoverTypeId" asp-items="Model.CoverTypeList" class="form-control">
    <option value="value">Select CoverType</option>
</select>
            </div>
            <div class="form-group row p-2 m-2">
                    @if (Model.Product.Id != 0)
                    {
                        <partial name="_UpdateAndBackToListButtons" />
                    }
                    else
                    {
                        <div class="row">
                            <div class="col">
                                <button type="submit" class="btn btn-primary form-control">Save</button>
                            </div>
                            <div class="col">
                            <a asp-action="Index" class="btn btn-danger form-control">Back To List</a>
                            </div>
                        </div>
                    }
                </div>
            </form>
    </div>
    <div class="col-6">
        @if(Model.Product.ImageUrl!=null)
        {
            <img src="@Model.Product.ImageUrl" height="40%"width="80%"/>
        }
    </div>
</div>