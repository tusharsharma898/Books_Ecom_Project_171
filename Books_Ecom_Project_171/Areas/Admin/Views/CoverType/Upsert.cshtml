@model Books_Ecom_Project_171_Models.CoverType

@{
    var title = Model.Id != 0 ? "Edit CoverType" : "Add New Cover Type";
    //var saveUpdate = Model.Id != 0 ? "Update" : "Save";
}
<div class="col-9">
    <h2 class="text-info text-center">@title</h2>
</div>
<form method="post">

    @if (Model.Id == 0)
    {
        <input type="hidden" asp-for="Id" />
    }
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    
    <div class="col-8 border">
        <div class="p-2 m-2 form-group row">
            <div class="col-4">
                <label asp-for="Name" class="m-2"></label>
            </div>
            <div class="col-8">
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
        <div class="col-8 offset-4">
        <div class="form-group row p-2 m-2">
            
                    @if (Model.Id != 0)
                    {
                       <partial name="_UpdateAndBackToListButtons" /> 
                    }
                    else
                    {
                        <partial name="_SaveAndBackToListButtons" />
                    }
                </div>
        </div>
        @* <div class="p-2 m-2 form-group row">
            <div class="col-4 offset-4">
                <button type="submit" class="btn btn-info form-control">@saveUpdate</button>
            </div>
            <div class="col-4">
                <a asp-action="Index" class="btn btn-secondary form-control">Back to list</a>
            </div>
        </div> *@
    </div>

</form>